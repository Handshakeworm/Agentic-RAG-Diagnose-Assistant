  "panels": [
    {
      "title": "QPS - HTTP 总请求率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{handler!=\"none\"}[1m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineInterpolation": "linear",
            "spanNulls": true,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 0
          }
        }
      }
    },
    {
      "title": "HTTP 5xx 错误率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{status=~\"5..\",handler!=\"none\"}[1m])) or vector(0)) / sum(rate(http_requests_total{handler!=\"none\"}[1m]))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "custom": {
            "lineInterpolation": "linear",
            "spanNulls": true,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 0
          }
        }
      }
    },
